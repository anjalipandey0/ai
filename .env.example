# ===============================================
# VELOUR & WEAVE - Environment Configuration
# ===============================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
# Replace with your MongoDB Atlas cluster connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/velour_weave?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/velour_weave?retryWrites=true&w=majority

# Client URLs (CORS)
CLIENT_URL=http://localhost:5173

# Frontend Vite API URL (Leave as /api for local Vite proxy, or set to your Render backend API)
VITE_API_URL=http://localhost:5000/api
